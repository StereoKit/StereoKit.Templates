{
	"$schema": "http://json.schemastore.org/template",
	"author": "StereoKit",
	"classifications": [ "StereoKit", "Desktop", "Windows", "Linux", "Android" ],
	"identity": "StereoKitTemplates.NetCoreSketch",
	"name": "StereoKit: Sketch",
	"description": "A bare-bones StereoKit Mixed Reality template for small code sketches, for Android/Windows/Linux.",
	"shortName": "sk-sketch",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"sourceName": "SKTemplate_Sketch.1",
	"sources":[{
		"modifiers": [
			{ "exclude": [ ".vs/**/*"] }
		]
	}],
	"primaryOutputs": [{
		"path": "SKTemplate_Sketch.1.csproj"
	}],
	"postActions": [{
		"description": "Restore NuGet packages required by this project.",
		"manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
		"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
		"continueOnError": true
	},{
		"description": "Restore required .NET workloads (e.g., Android).",
		"manualInstructions": [{ "text": "Run 'dotnet workload restore'" }],
		"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
		"args": {
			"executable": "dotnet",
			"args": "workload restore",
			"redirectStandardOutput": false
		},
		"continueOnError": true
	}],
	"symbols": {
		"framework": {
			"type": "parameter",
			"description": "The target framework for the project.",
			"datatype": "choice",
			"choices": [
				{ "choice": "net10.0", "description": "Target .NET 10" },
				{ "choice": "net9.0", "description": "Target .NET 9" },
				{ "choice": "net8.0", "description": "Target .NET 8" }
			],
			"replaces": "net10.0",
			"defaultValue": "net10.0"
		}
	}
}